APP_ENV=development
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# مزود المودل: mock | oracle | lmstudio | local
# mock:     الافتراضي، يعمل بلا أي خدمة خارجية ويعيد ردًا تجريبيًا.
# oracle:   OCI Generative AI (يحتاج OCI_* وهوية OCI على السيرفر).
# llamacpp: مودل محلي داخل GovMind Runtime — **لا يحتاج LM Studio مثبَّتة**.
# lmstudio: مودل محلي داخل LM Studio على الجهاز نفسه (انظر LM_STUDIO_* أدناه).
# local:    واجهة مستقبلية، غير منفّذة.
MODEL_PROVIDER=mock

# عنوان الـBackend كما يراه متصفح الموظف. يُدمج في الواجهة وقت البناء، فتغييره
# يستلزم: docker compose up --build. اتركه فارغًا ليُستخدم http://localhost:8000
NEXT_PUBLIC_BACKEND_URL=

# سر توقيع رموز الدخول (JWT). **اتركه فارغًا محليًا فقط.**
# فارغًا في APP_ENV=development: يُولَّد سر عشوائي عند كل تشغيل، فتسقط الرموز
# القديمة عند إعادة التشغيل — مقبول محليًا.
# خارج التطوير: **إلزامي**، وبدونه تُرفض كل الطلبات المحمية برسالة واضحة.
# ولّده بأمر: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# مخزن بيانات العمل (الجهات والمستخدمون).
# supabase: جداول Supabase/PostgreSQL مع RLS (يحتاج SUPABASE_* أدناه).
# memory: مخزن داخل ذاكرة العملية مزروع بالمستخدمين التجريبيين — للتطوير فقط،
#         غير دائم ويفرغ عند إعادة التشغيل.
# oracle: جداول قاعدة Oracle (يحتاج ORACLE_* مضبوطة).
DATA_STORE=memory

# كلمة مرور المستخدمين التجريبيين في مخزن الذاكرة وحده. حسابات وهمية على نطاق
# ‎.test‎ ومخزن غير دائم، فليست سرًا. تُهمَل تمامًا مع DATA_STORE=oracle.
DEV_SEED_PASSWORD=GovAgent@2026

# مفتاح تجهيز الجهات — يحرس POST /api/organizations وحده.
# إنشاء جهة جديدة عملية تركيب يقوم بها من ينشر النظام، لا عملية داخل التطبيق.
# **إلزامي في كل البيئات، بلا استثناء للتطوير.** تركه فارغًا **يعطّل المسار**
# ولا يجعله مفتوحًا: مسار ينشئ جهة كاملة بمسؤول لها لا يُترك بلا حارس.
# التطوير المحلي لا يحتاجه — مخزن الذاكرة مزروع بجهتين جاهزتين.
# ولّده بأمر: python -c "import secrets; print(secrets.token_urlsafe(48))"
PROVISIONING_KEY=

# مجلد حفظ الملفات المرفوعة على قرص السيرفر، نسبيًا إلى مجلد تشغيل الخدمة.
# مُدرَج في .gitignore. القاعدة تحفظ المسار لا محتوى الملف.
UPLOAD_DIR=uploads

ORACLE_DSN=
ORACLE_USER=
ORACLE_PASSWORD=

OCI_REGION=
OCI_COMPARTMENT_ID=
OCI_MODEL_ID=

# هوية OCI على السيرفر. اتركها فارغة مع MODEL_PROVIDER=mock.
# OCI_AUTH_TYPE: config (ملف ~/.oci/config) أو instance_principal (سيرفر داخل OCI).
OCI_AUTH_TYPE=
OCI_CONFIG_FILE=
OCI_CONFIG_PROFILE=

# --- LM Studio (MODEL_PROVIDER=lmstudio) -------------------------------------
# مودل يعمل على جهاز الجهة نفسه، بواجهة متوافقة مع OpenAI. لا يخرج أي نص من
# الجهاز. الخطوات: افتح LM Studio ← حمّل المودل ← شغّل Local Server، ثم اضبط
# MODEL_PROVIDER=lmstudio أعلاه.
#
# العنوان الأساسي للخادم المحلي، **بلا / في آخره وبانتهاء /v1**:
#   تشغيل الـBackend مباشرة على ويندوز/ماك/لينكس: http://127.0.0.1:1234/v1
#   تشغيل الـBackend داخل Docker:                 http://host.docker.internal:1234/v1
# القيمة أدناه هي الصحيحة للتشغيل المباشر، فلا تحتاج تعديلًا إلا داخل Docker.
# **لا تتركه فارغًا:** الفراغ يُقرأ كقيمة صريحة فارغة ويُرفض برسالة إعداد ناقص.
LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1

# معرّف المودل كما يظهر في LM Studio (تبويب Developer / Local Server).
LM_STUDIO_MODEL=google/gemma-4-e4b

# مهلة انتظار الرد بالثواني. التوليد المحلي أبطأ من الخدمات السحابية، ومهلة
# قصيرة تقطع إجابة سليمة في منتصفها. قياس فعلي: سؤال إداري متوسط استغرق ٢٦٢
# ثانية عبر المسار الكامل، فـ300 تترك هامشًا. ارفعها إن كان الجهاز أبطأ.
LM_STUDIO_TIMEOUT_SECONDS=300

# سقف طول الإجابة بالرموز (Tokens). زمن التوليد المحلي يتناسب طرديًا معه.
# ⚠️ **لا تخفضها إلى 512.** مودلات الاستدلال (Reasoning) — ومنها
# google/gemma-4-e4b — تستهلك مئات الرموز في تفكير داخلي قبل أول حرف من
# الإجابة: قياس فعلي أعطى 509 رموز استدلال، فالسقف 512 أعاد إجابة **فارغة**
# و1500 أعاد ردًا كاملًا. المزود يميّز هذه الحالة برسالة تطلب رفع القيمة.
LM_STUDIO_MAX_TOKENS=1500

# **اتركه فارغًا.** LM Studio محلي ولا يطلب مفتاحًا. يُملأ فقط إن وُضع أمامه
# وسيط (Proxy) يشترط ترويسة Authorization.
LM_STUDIO_API_KEY=

# المتجهات (Embeddings) للبحث في الملفات المرفوعة.
# mock يعمل محليًا بلا أي خدمة خارجية. oracle يحتاج OCI_EMBEDDING_MODEL_ID.
EMBEDDING_PROVIDER=mock
OCI_EMBEDDING_MODEL_ID=

# مخزن مقاطع الملفات والبحث فيها.
# memory: مخزن محلي داخل ذاكرة العملية، يعمل بلا قاعدة بيانات (للتطوير والعرض،
#         غير دائم ويفرغ عند إعادة التشغيل).
# oracle: Oracle Vector Search فوق جدول document_chunks (يحتاج ORACLE_* مضبوطة).
RETRIEVAL_PROVIDER=memory


# ============================================================
# Supabase — الحسابات والجهات والاشتراكات وتفعيل الأجهزة
# ============================================================
# مزوّد بيانات **ثالث** إلى جانب memory و oracle، يُختار بـDATA_STORE=supabase.
# اترك الحقول فارغة والمشروع يعمل كما كان: الاتصال كسول ولا يُلمس شيء منها.
#
# قبل الاستخدام: نفّذ database/supabase/0001_govmind_supabase.sql من
# SQL Editor في مشروعك. الملف ينتهي باختبارات عزل تُفشل الهجرة إن تسرّبت
# بيانات بين المستخدمين أو الجهات.

# عنوان المشروع، بلا / في آخره. مثال: https://abcdefgh.supabase.co
SUPABASE_URL=

# المفتاح العام (anon / publishable). يستخدمه الـBackend في تسجيل الدخول
# وحده. ليس سرًّا بطبيعته — RLS هو ما يحمي البيانات لا سرّية هذا المفتاح.
SUPABASE_ANON_KEY=

# ⚠️ **مفتاح يتجاوز RLS بالكامل.** الـBackend وحده يحمله.
# **لا يوضع في الواجهة ولا في إضافة المتصفح ولا في أي ملف داخل المستودع.**
SUPABASE_SERVICE_ROLE_KEY=

# سرّ توقيع رموز Supabase القديم (Project Settings ← API ← JWT Secret).
#
# ⚠️ **اتركه فارغًا في المشاريع الحديثة.** Supabase صارت توقّع رموز
# المستخدمين بمفتاح غير متماثل (ES256/RS256) وتنشر نظيره العام على
# `/auth/v1/.well-known/jwks.json`؛ والـBackend يجلبه من هناك ويخزّنه، فلا
# يحتاج سرًّا. تحقّق من طريقة مشروعك بفتح:
#   {SUPABASE_URL}/auth/v1/.well-known/jwks.json
# إن رجع مفتاحًا بـalg=ES256 أو RS256 فمشروعك حديث، وهذا المتغيّر لا لزوم
# له. وإن كان مشروعك قديمًا يوقّع بـHS256 فاضبطه — بدونه تُرفض كل الطلبات
# المحمية.
SUPABASE_JWT_SECRET=


# ============================================================
# تفعيل الأجهزة — جهاز واحد لكل اشتراك
# ============================================================
# مِلح سرّي يدخل في تجزئة بصمة الجهاز.
# **البصمة الخام لا تُخزَّن أبدًا**؛ يُخزَّن HMAC-SHA256 لها بهذا المِلح.
# بلا مِلح يتوقّف تفعيل الأجهزة برسالة إعداد واضحة — ولا يُخزَّن شيء ضعيف
# بصمت. ولّده مرة واحدة بقيمة عشوائية طويلة، ولا تغيّره بعد التشغيل:
# تغييره يُبطل تجزئات كل الأجهزة المفعّلة فتحتاج تفعيلًا جديدًا.
DEVICE_HASH_PEPPER=


# ============================================================
# Azure Blob Storage — توزيع مثبّت GovMind
# ============================================================
# ⚠️ **لا تودِع سلسلة الاتصال في المستودع.** تحمل مفتاح الحساب، ولا تخرج من
# الـBackend إلى أي عميل. الواجهة والإضافة لا تعرفان عنوان Azure أصلًا:
# يصلهما رابط SAS موقّع قصير العمر يولّده السيرفر.

# اسم حساب التخزين.
AZURE_STORAGE_ACCOUNT=

# اسم الحاوية التي تحمل ملفات الإصدار.
AZURE_STORAGE_CONTAINER=

# مدوّنتان منفصلتان: المثبّت صغير والمودل بالجيجابايتات. حزمهما معًا يجعل
# كل تحديث صغير في البرنامج يعيد تنزيل المودل كاملًا.
AZURE_INSTALLER_BLOB_NAME=
AZURE_MODEL_BLOB_NAME=

# بيانات التحقق من ملف المودل. **بدونهما لا يُقبل المودل** مهما اكتمل
# تنزيله: ملف بحجم صحيح وتجزئة خاطئة ملفٌ تالف أو مستبدَل.
# احسبهما بعد رفع الملف:
#   certutil -hashfile <model.gguf> SHA256
AZURE_MODEL_SHA256=
AZURE_MODEL_SIZE_BYTES=

# ---------------------------------------------------------------------------
# LiveKit Inference — **استدلال سحابي**
# ---------------------------------------------------------------------------
# ⚠️ **هذا المزوّد وحده يرسل نصّ المحادثة خارج السيرفر.** `lmstudio` و
# `llamacpp` يبقيان النصّ على الجهاز. اختياره قرارٌ يخصّ خصوصية البيانات،
# وأي واجهة تعرضه يجب أن تقول للمستخدم إن المعالجة سحابية.
#
# للتفعيل: MODEL_PROVIDER=livekit
#
# ⚠️ **المفتاح والسرّ يبقيان على السيرفر.** لا يوضعان في الواجهة ولا في
# الإضافة ولا في الـRuntime على جهاز العميل. ما يُرسل إلى بوابة LiveKit
# رمزٌ قصير العمر يولّده السيرفر لكل طلب.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# معرّف المودل بصيغة provider/model.
# gemini-2.5-flash-lite: عربية جيدة بأقلّ كلفة تقريبًا.
LIVEKIT_MODEL=google/gemini-2.5-flash-lite

# بوابة الاستدلال. فارغة = تُشتقّ من LIVEKIT_URL، وهو المطلوب عادةً.
LIVEKIT_INFERENCE_URL=

# مهلة منتهية دائمًا — لا انتظار بلا حدّ لخدمة خارجية.
LIVEKIT_TIMEOUT_SECONDS=120
LIVEKIT_MAX_TOKENS=1500
LIVEKIT_TEMPERATURE=0.3

# عمر رمز الوصول بالثواني. قصير عمدًا: يُولَّد لكل طلب ولا يُخزَّن.
LIVEKIT_TOKEN_TTL_SECONDS=600

# الاسم القديم من المرحلة الأولى — يبقى بديلًا لـAZURE_INSTALLER_BLOB_NAME
# حتى لا ينكسر إعداد قائم. اتركه فارغًا في التركيبات الجديدة.
AZURE_STORAGE_BLOB_NAME=

# سلسلة الاتصال الكاملة (Access keys ← Connection string).
AZURE_STORAGE_CONNECTION_STRING=

# عمر رابط التحميل المؤقّت بالدقائق. قصير عمدًا: الرابط يمنح حاملَه التحميل
# بلا هوية، فكل دقيقة زائدة نافذة تسريب زائدة. الإضافة تطلب رابطًا جديدًا
# عند الحاجة، فلا داعي لإطالته.
DOWNLOAD_LINK_TTL_MINUTES=15


# ============================================================
# جلسات التركيب — نقل الثقة من الإضافة إلى GovMind Runtime
# ============================================================
# عمر رمز التركيب بالدقائق. **نافذة تركيب لا جلسة**: يكفي أن يعيش حتى
# ينزّل العميل المثبّت ويشغّله. الإطالة توسّع نافذة إساءة الاستعمال بلا
# فائدة، والإضافة تطلب رمزًا جديدًا متى لزم.
INSTALLATION_TOKEN_TTL_MINUTES=15


# ============================================================
# llama.cpp — المودل داخل GovMind Runtime (بلا LM Studio)
# ============================================================
# ⚠️ **لا تضبط هذه على السيرفر المستضاف.** يكتبها GovMind Runtime على جهاز
# العميل بنفسه بعد أن يحجز منفذًا حرًّا على الاسترجاع المحلي. مذكورة هنا
# للتوثيق ولتشغيل الـBackend محليًا مقابل llama-server يدوي.
LLAMACPP_BASE_URL=
LLAMACPP_MODEL=govmind-local
LLAMACPP_TIMEOUT_SECONDS=300
LLAMACPP_MAX_TOKENS=1500
