APP_ENV=development
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
MODEL_PROVIDER=mock

# عنوان الـBackend كما يراه متصفح الموظف. يُدمج في الواجهة وقت البناء، فتغييره
# يستلزم: docker compose up --build. اتركه فارغًا ليُستخدم http://localhost:8000
NEXT_PUBLIC_BACKEND_URL=

ORACLE_DSN=
ORACLE_USER=
ORACLE_PASSWORD=

OCI_REGION=
OCI_COMPARTMENT_ID=
OCI_MODEL_ID=

# هوية OCI على السيرفر. اتركها فارغة مع MODEL_PROVIDER=mock.
# OCI_AUTH_TYPE: config (ملف ~/.oci/config) أو instance_principal (سيرفر داخل OCI).
OCI_AUTH_TYPE=
OCI_CONFIG_FILE=
OCI_CONFIG_PROFILE=

# المتجهات (Embeddings) للبحث في الملفات المرفوعة.
# mock يعمل محليًا بلا أي خدمة خارجية. oracle يحتاج OCI_EMBEDDING_MODEL_ID.
EMBEDDING_PROVIDER=mock
OCI_EMBEDDING_MODEL_ID=

# مخزن مقاطع الملفات والبحث فيها.
# memory: مخزن محلي داخل ذاكرة العملية، يعمل بلا قاعدة بيانات (للتطوير والعرض،
#         غير دائم ويفرغ عند إعادة التشغيل).
# oracle: Oracle Vector Search فوق جدول document_chunks (يحتاج ORACLE_* مضبوطة).
RETRIEVAL_PROVIDER=memory
